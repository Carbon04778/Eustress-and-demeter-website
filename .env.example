# Copy this file to .env for local `vercel dev`, and set the same values
# in Vercel: Project Settings -> Environment Variables.
#
# Nothing here is required for the site or forms to work — without
# RESEND_API_KEY, /api/contact still accepts submissions and logs them
# (see api/contact.js), and the forms fall back to opening the visitor's
# email client. Add the key when you're ready to send real email.

# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that inquiries are delivered to. Defaults to info@eustressanddemeter.com
CONTACT_TO_EMAIL=info@eustressanddemeter.com

# The "from" address inquiries are sent as. Must be on a domain verified in
# Resend. Until you verify a domain, Resend's shared address below works
# for testing.
CONTACT_FROM_EMAIL=Eustress & Demeter Website <onboarding@resend.dev>
